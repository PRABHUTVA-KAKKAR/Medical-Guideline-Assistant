# Copy to .env and paste your key. Committed as a template only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mohfw_guidelines
# dense = Qdrant cosine search (needs Qdrant up + ingested); keyword = local TF-IDF+BM25
RETRIEVAL_BACKEND=dense
